<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ report_name }}</title>
{#- section lookup -#}
{%- set S = {} -%}
{%- for s in sections %}{% set _ = S.update({s.key: s}) %}{% endfor -%}
{%- set OVR = (S.overall.data if S.overall else []) -%}
{%- set O = OVR[0] if OVR else {} -%}
{%- set ENT = S.entities.data if S.entities else [] -%}
{%- set TRD = S.trend.data if S.trend else [] -%}
{%- set SEC = S.sectors.data if S.sectors else [] -%}
{%- set NOT = S.notes.data if S.notes else [] -%}
{%- macro money(v) -%}
  {%- if v is none %}&mdash;{%- else %}{{ v|round(2)|fmt }}{%- endif -%}
{%- endmacro -%}
{%- macro mn(v) -%}
  {%- if v is none %}&mdash;{%- else %}{{ (v / 1000000)|round(1)|fmt }}M{%- endif -%}
{%- endmacro -%}
{%- macro pc(v) -%}
  {%- if v is none %}&mdash;{%- else %}{{ v|round(1) }}%{%- endif -%}
{%- endmacro -%}
{#- max value across the trend bars, for bar heights -#}
{%- set ns = namespace(mx=1) -%}
{%- for r in TRD -%}
  {%- if (r.budget or 0) > ns.mx %}{% set ns.mx = r.budget %}{% endif -%}
  {%- if (r.actual or 0) > ns.mx %}{% set ns.mx = r.actual %}{% endif -%}
  {%- if (r.ytd_plan or 0) > ns.mx %}{% set ns.mx = r.ytd_plan %}{% endif -%}
{%- endfor -%}
<style>
  :root { --brand: #3F6F5F; --brand-d: #2C5044; --gold: #C8A24B; --ink: #1F2933;
          --mut: #7B8794; --line: #DCE3DF; --soft: #F1F6F3; --red: #B3352B; }
  * { box-sizing: border-box; }
  body { font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif; color: var(--ink);
         margin: 0; font-size: 10px; }
  @page { size: A4 landscape; }
  .hd { border-bottom: 4px solid var(--brand); padding: 0 0 10px; margin-bottom: 12px; }
  .hd .org { font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--mut); }
  .hd h1 { font-size: 21px; font-weight: 700; color: var(--brand); margin: 3px 0 2px; }
  .hd .sub { font-size: 10.5px; color: #52606d; }
  .kpis { display: flex; gap: 10px; margin: 12px 0 14px; }
  .kpi { flex: 1; border: 1px solid var(--line); border-left: 4px solid var(--brand);
         border-radius: 7px; padding: 8px 12px; background: #fff; }
  .kpi.gold { border-left-color: var(--gold); }
  .kpi .v { font-size: 17px; font-weight: 700; color: var(--brand-d); }
  .kpi .s { font-size: 8.6px; color: var(--mut); margin-top: 1px; }
  .kpi .l { font-size: 8.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--mut); margin-top: 2px; }
  h2 { font-size: 13.5px; color: var(--brand-d); border-bottom: 2px solid var(--brand);
       padding-bottom: 4px; margin: 16px 0 6px; page-break-after: avoid; }
  .note { font-size: 9px; color: var(--mut); margin: 2px 0 8px; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 6px; }
  thead th { background: var(--brand); color: #fff; font-weight: 600; text-align: left;
             padding: 5px 7px; font-size: 8.7px; border: 1px solid var(--brand); }
  tbody td { padding: 4px 7px; border: 1px solid #e4e7eb; vertical-align: top; }
  tbody tr:nth-child(even) td { background: var(--soft); }
  td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td.neg { color: var(--red); font-weight: 700; }
  .gauges { display: flex; gap: 10px; margin: 6px 0 12px; }
  .gauge { flex: 1; border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px 10px;
           text-align: center; background: #fff; page-break-inside: avoid; }
  .gauge .t { font-weight: 700; font-size: 11px; color: var(--brand-d); margin-bottom: 2px; }
  .gauge svg { width: 118px; height: 66px; display: block; margin: 0 auto; }
  .gauge .pv { font-size: 14px; font-weight: 800; margin-top: -6px; }
  .gauge .pk { font-size: 7.8px; letter-spacing: .06em; text-transform: uppercase; color: var(--mut); }
  .gchips { display: flex; gap: 5px; margin-top: 7px; }
  .gchips span { flex: 1; border: 1px solid var(--line); border-radius: 6px; padding: 4px 2px; }
  .gchips b { display: block; font-size: 9.4px; }
  .gchips i { display: block; font-style: normal; font-size: 7.2px; color: var(--mut); }
  .chart { display: flex; gap: 26px; align-items: flex-end; height: 150px; margin: 22px 8px 4px;
           border-bottom: 2px solid var(--line); padding: 0 16px; }
  .cg { flex: 1; display: flex; gap: 7px; align-items: flex-end; justify-content: center; height: 100%; position: relative; }
  .cb { width: 34px; border-radius: 3px 3px 0 0; position: relative; }
  .cb.bud { background: var(--brand); }
  .cb.act { background: var(--gold); }
  .cb.pln { background: #8FB3A6; }
  .cb b { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%);
          font-size: 7.6px; white-space: nowrap; padding-bottom: 1px; }
  .cx { display: flex; gap: 26px; padding: 0 16px; margin-bottom: 8px; }
  .cx span { flex: 1; text-align: center; font-size: 9px; font-weight: 700; color: var(--brand-d); padding-top: 4px; }
  .legend { display: flex; gap: 14px; font-size: 8.4px; color: var(--mut); margin: 0 16px 2px; }
  .legend i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 4px; vertical-align: -1px; }
  .two { display: flex; gap: 12px; margin: 8px 0 4px; }
  .vbox { flex: 1; border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; background: #fff; }
  .vbox .t { font-weight: 700; font-size: 10px; color: var(--brand-d); margin-bottom: 4px; }
  .vbox .b { font-size: 9.4px; white-space: pre-wrap; }
  .vbox .m { font-size: 7.8px; color: var(--mut); margin-top: 5px; }
  .brk { page-break-before: always; }
  .keep { page-break-inside: avoid; }
  .bar { display: inline-block; height: 7px; border-radius: 4px; background: var(--brand); vertical-align: middle; }
  .foot { margin-top: 10px; font-size: 8.5px; color: var(--mut); text-align: center; }
</style>
</head>
<body>

  <div class="hd">
    <div class="org">Oracle Fusion i-Finance &middot; Reporting Platform</div>
    <h1>Financial Performance Report</h1>
    <div class="sub">Budget Overview &middot; period {{ params.period }} (figures YTD)
      &middot; Budget Group 1 &middot; Chapters 1&ndash;3 (Payroll / Opex / Capex)
      {% if params.entity %}&middot; entity {{ params.entity }}{% endif %}
      &middot; generated {{ generated_at_pretty or generated_at }}
      &middot; Prepared by Financial Planning and Budgeting &mdash; Finance Department</div>
  </div>

  <div class="kpis">
    <div class="kpi"><div class="v">{{ mn(O.budget) }}</div><div class="l">Budget (AED)</div>
      <div class="s">{{ money(O.budget) }}</div></div>
    <div class="kpi"><div class="v">{{ mn(O.actual) }}</div><div class="l">Actual (AED)</div>
      <div class="s">Actual vs Budget {{ pc(O.actual_vs_budget_pct) }}</div></div>
    <div class="kpi gold"><div class="v">{% if O.has_plan == 'Y' %}{{ mn(O.ytd_plan) }}{% else %}&mdash;{% endif %}</div>
      <div class="l">YTD Plan (AED)</div>
      <div class="s">{% if O.has_plan == 'Y' %}Plan vs Budget {{ pc(O.plan_vs_budget_pct) }}{% else %}no plan loaded{% endif %}</div></div>
    <div class="kpi gold"><div class="v">{{ pc(O.actual_vs_plan_pct) }}</div><div class="l">Actual vs Plan</div>
      <div class="s">Actual &divide; YTD Plan &times; 100</div></div>
    <div class="kpi"><div class="v">{{ mn(O.funds_available) }}</div><div class="l">Funds Available (AED)</div>
      <div class="s">{{ money(O.funds_available) }}</div></div>
  </div>

  <h2>Budget Overview &mdash; Entity Level</h2>
  <div class="note">Entity from the combination's entity-specific segment (ALC 4510600, Museums 4510700; Masterpieces = appropriation 301439, carved out of DCT). Gauge = Actual vs Budget %.</div>
  <div class="gauges">
    {% for e in ENT %}
    {% set p = e.actual_vs_budget_pct if e.actual_vs_budget_pct is not none else 0 %}
    {% set dash = (([p, 100]|min) / 100 * 251.3)|round(1) %}
    <div class="gauge">
      <div class="t">{{ e.entity }}</div>
      <svg viewBox="0 0 200 110" aria-hidden="true">
        <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="#E3EAE6" stroke-width="18" stroke-linecap="round"></path>
        <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="#3F6F5F" stroke-width="18" stroke-linecap="round"
              stroke-dasharray="{{ dash }} 251.3"></path>
      </svg>
      <div class="pv">{{ pc(e.actual_vs_budget_pct) }}</div>
      <div class="pk">Actual vs Budget</div>
      <div class="gchips">
        <span><b>{{ mn(e.budget) }}</b><i>Budget</i></span>
        <span><b>{{ mn(e.actual) }}</b><i>Actual</i></span>
        <span><b>{% if e.has_plan == 'Y' %}{{ mn(e.ytd_plan) }}{% else %}&mdash;{% endif %}</b><i>YTD Plan</i></span>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="keep">
  <h2>YTD Trend &mdash; Payroll / Opex / Capex</h2>
  <div class="legend">
    <span><i style="background:#3F6F5F"></i>Budget</span>
    <span><i style="background:#C8A24B"></i>Actual</span>
    <span><i style="background:#8FB3A6"></i>YTD Plan</span>
  </div>
  <div class="chart">
    {% for r in TRD %}
    <div class="cg">
      <div class="cb bud" style="height: {{ ((r.budget or 0) / ns.mx * 100)|round(1) }}%"><b>{{ mn(r.budget) }}</b></div>
      <div class="cb act" style="height: {{ ((r.actual or 0) / ns.mx * 100)|round(1) }}%"><b>{{ mn(r.actual) }}</b></div>
      <div class="cb pln" style="height: {{ ((r.ytd_plan or 0) / ns.mx * 100)|round(1) }}%"><b>{% if r.has_plan == 'Y' %}{{ mn(r.ytd_plan) }}{% else %}&mdash;{% endif %}</b></div>
    </div>
    {% endfor %}
  </div>
  <div class="cx">{% for r in TRD %}<span>{{ r.type }}</span>{% endfor %}</div>
  <table>
    <thead><tr><th>Type</th><th style="text-align:right">Budget (AED)</th><th style="text-align:right">Actual (AED)</th>
      <th style="text-align:right">Actual vs Budget</th><th style="text-align:right">YTD Plan (AED)</th></tr></thead>
    <tbody>
      {% for r in TRD %}
      <tr><td>{{ r.type }}</td><td class="num">{{ money(r.budget) }}</td><td class="num">{{ money(r.actual) }}</td>
        <td class="num">{{ pc(r.actual_vs_budget_pct) }}</td>
        <td class="num">{% if r.has_plan == 'Y' %}{{ money(r.ytd_plan) }}{% else %}&mdash;{% endif %}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>

  {% if NOT %}
  <div class="two">
    {% for n in NOT %}
    <div class="vbox">
      <div class="t">{{ n.commentary }}</div>
      <div class="b">{{ n.note or '—' }}</div>
      <div class="m">{{ n.updated_by }} &middot; {{ n.updated_on }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <h2 class="brk">Budget Overview &mdash; Sector Level</h2>
  <div class="note">Sectors ranked by Actual vs YTD Plan % (the page's ordering). {{ SEC|length }} sectors in scope.</div>
  <table>
    <thead><tr><th>Sector</th><th style="text-align:right">Budget (AED)</th><th style="text-align:right">Actual (AED)</th>
      <th style="text-align:right">Actual vs Budget</th><th style="text-align:right">YTD Plan (AED)</th>
      <th style="text-align:right">Actual vs Plan</th><th style="width:120px">Actual vs Plan</th></tr></thead>
    <tbody>
      {% for r in SEC %}
      <tr>
        <td>{{ r.sector }}</td>
        <td class="num">{{ money(r.budget) }}</td>
        <td class="num">{{ money(r.actual) }}</td>
        <td class="num">{{ pc(r.actual_vs_budget_pct) }}</td>
        <td class="num">{% if r.has_plan == 'Y' %}{{ money(r.ytd_plan) }}{% else %}&mdash;{% endif %}</td>
        <td class="num">{% if r.has_plan == 'Y' %}{{ pc(r.actual_vs_plan_pct) }}{% else %}&mdash;{% endif %}</td>
        <td>{% if r.actual_vs_plan_pct is not none %}<span class="bar" style="width: {{ (([r.actual_vs_plan_pct, 130]|min) / 130 * 110)|round(1) }}px"></span>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="foot">Financial Performance Report &middot; Budget Overview &middot; {{ params.period }} &middot;
    generated {{ generated_at_pretty or generated_at }} by i-Finance Reporting</div>
</body>
</html>
