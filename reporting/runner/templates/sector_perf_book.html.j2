            <td class="num">{{ money(d.budget_annual) }}</td><td class="num">{{ money(d.actual_total) }}</td>
            <td class="num">{{ money(d.plan_ytd) }}</td>
            <td class="num">{{ (d.actual_budget_pct|fmt ~ '%') if d.actual_budget_pct is not none else '—' }}</td>
            <td class="num">{{ (d.actual_plan_pct|fmt ~ '%') if d.actual_plan_pct is not none else '—' }}</td></tr>
        </tbody>
      </table>
      {% else %}<div class="empty">No expenditure-kind data.</div>{% endif %}
    </div>
    <div class="chart" style="flex: 1.35 1 0">
      <div class="ch-t">Budget overview by Project &mdash; top {{ dprj|length }}{% if dprj and dprj[0].proj_count and dprj[0].proj_count > dprj|length %} of {{ dprj[0].proj_count|fmt }}{% endif %} by budget</div>
      {% if dprj %}
      <table class="data">
        <thead><tr><th>Project</th><th class="num">Annual Budget</th><th class="num">Actual</th><th class="num">Encumbrance</th><th class="num">Fund Available</th><th class="num">Actual/Budget %</th><th class="num">Actual/Plan %</th></tr></thead>
        <tbody>
          {% for p in dprj %}
          <tr><td>{{ p.project_number }} &middot; {{ p.project_name or '—' }}</td><td class="num">{{ money(p.budget_annual) }}</td>
            <td class="num">{{ money(p.actual_total) }}</td><td class="num">{{ money(p.encumbrance) }}</td>
            <td class="num {{ 'neg' if p.fund_available is not none and p.fund_available < 0 }}">{{ money(p.fund_available) }}</td>
            <td class="num">{{ (p.actual_budget_pct|fmt ~ '%') if p.actual_budget_pct is not none else '—' }}</td>
            <td class="num">{{ (p.actual_plan_pct|fmt ~ '%') if p.actual_plan_pct is not none else '—' }}</td></tr>
          {% endfor %}
        </tbody>
        {% set p_ba = dprj|map(attribute='budget_annual')|select('number')|sum %}
        {% set p_at = dprj|map(attribute='actual_total')|select('number')|sum %}
        {% set p_en = dprj|map(attribute='encumbrance')|select('number')|sum %}
        {% set p_fa = dprj|map(attribute='fund_available')|select('number')|sum %}
        {% set p_pl = dprj|map(attribute='plan_ytd')|select('number')|sum %}
        <tfoot><tr><td>Total &mdash; top {{ dprj|length }} projects</td>
          <td class="num">{{ money(p_ba) }}</td><td class="num">{{ money(p_at) }}</td>
          <td class="num">{{ money(p_en) }}</td>
          <td class="num {{ 'neg' if p_fa < 0 }}">{{ money(p_fa) }}</td>
          <td class="num">{{ ((100*p_at/p_ba)|round(1)|fmt ~ '%') if p_ba else '—' }}</td>
          <td class="num">{{ ((100*p_at/p_pl)|round(1)|fmt ~ '%') if p_pl else '—' }}</td></tr></tfoot>
      </table>
      {% if dprj[0].proj_count and dprj[0].proj_count > dprj|length %}<div class="tbl-note">Top {{ dprj|length }} of {{ dprj[0].proj_count|fmt }} projects &mdash; a further {{ money((d.budget_annual or 0) - p_ba) }} of the department&rsquo;s {{ money(d.budget_annual) }} annual budget sits on the remaining {{ (dprj[0].proj_count - dprj|length)|fmt }} project(s).</div>{% endif %}
      {% else %}<div class="empty">No project data.</div>{% endif %}
    </div>
  </div>
  <div class="foot">Part 4 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>
{%- endfor %}
{%- if not DEP %}
<div class="page">
  <div class="pt-band"><span class="pt-no">04</span><span class="pt-t">Top 5 Projects Budget by Department</span>
    <span class="pt-s">Budget year {{ params.year }}</span></div>
  <div class="empty">No department data in scope.</div>
  <div class="foot">Part 4 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>
{%- endif %}

{#- ═══ PART 5 — ACTUALS ════════════════════════════════════════════════ -#}
{#- supplier concentration computed from the line data; invoice counts from sp_supp -#}
{%- set sup = namespace(d={}) -%}
{%- for r in AP %}{% set k = r.supplier_name or '(Unknown supplier)' %}
  {%- set _ = sup.d.update({k: sup.d.get(k, 0) + (r.matched_aed or 0)}) %}{% endfor -%}
{%- for r in GRN %}{% set k = r.supplier_name or '(Unknown supplier)' %}
  {%- set _ = sup.d.update({k: sup.d.get(k, 0) + (r.received_aed or 0)}) %}{% endfor -%}
{%- set top_sup = sup.d.items()|sort(attribute='1', reverse=true) -%}
{%- set ap_total = AP|map(attribute='matched_aed')|select('number')|sum -%}
{%- set grn_total = GRN|map(attribute='received_aed')|select('number')|sum -%}
{%- set SUPC = {} -%}
{%- for r in (S.sp_supp.data if S.sp_supp else []) %}{% set _ = SUPC.update({r.supplier_name: r}) %}{% endfor -%}
{%- set paid_total = (X.get('ap_paid_aed') or 0) + (X.get('grn_paid_aed') or 0) -%}
<div class="page">
  <div class="pt-band"><span class="pt-no">05</span><span class="pt-t">Actuals — Supplier Invoices &amp; Goods Receipts</span>
    <span class="pt-s">{{ AP|length|fmt }} AP invoices &middot; {{ GRN|length|fmt }} GRN lines</span></div>

  <div class="kpis">
    <div class="kpi k-act"><div class="k-lbl">Total Actual</div><div class="k-val">{{ money(O.actual_total) }}</div><div class="k-sub">{{ (100 * (O.actual_total or 0) / O.budget)|round(1) if O.budget else '—' }}% of budget</div></div>
    <div class="kpi"><div class="k-lbl">AP Invoices (direct)</div><div class="k-val">{{ money(ap_total) }}</div><div class="k-sub">{{ AP|length|fmt }} invoices{% if X.get('ap_paid_pct') is not none %} &middot; <b>{{ X.get('ap_paid_pct')|fmt }}% paid</b>{% endif %}</div></div>
    <div class="kpi k-act"><div class="k-lbl">GRN Receipts</div><div class="k-val">{{ money(grn_total) }}</div><div class="k-sub">{{ GRN|length|fmt }} receipt lines{% if X.get('grn_paid_pct') is not none %} &middot; <b>{{ X.get('grn_paid_pct')|fmt }}% paid</b>{% endif %}</div></div>
    <div class="kpi"><div class="k-lbl">Active Suppliers</div><div class="k-val">{{ sup.d|length|fmt }}</div><div class="k-sub">across AP + GRN</div></div>
    <div class="kpi k-ok"><div class="k-lbl">Paid</div><div class="k-val">{{ money(paid_total) }}</div>
      <div class="k-sub">{% if X.get('actual_ytd') %}<b>{{ (100 * paid_total / X.get('actual_ytd'))|round(1)|fmt }}%</b> of the actual{% else %}AED paid to suppliers{% endif %}</div></div>
    <div class="kpi"><div class="k-lbl">Top Supplier Share</div>
      <div class="k-val">{{ (100 * top_sup[0][1] / (ap_total + grn_total))|round(1) if top_sup and (ap_total + grn_total) else '—' }}%</div>
      <div class="k-sub">{{ top_sup[0][0] if top_sup else '—' }}</div></div>
  </div>

  <div class="charts">
    <div class="chart sup-bars">
      <div class="ch-t">Top 10 suppliers by actual spend <small>&mdash; (invoices counted across direct AP and PO-matched)</small></div>
      {% for name, amt in top_sup[:10] %}
      {% set sr = SUPC.get(name) %}
      {% set c = sr.inv_count if sr else 0 %}
      {% set pp = sr.paid_pct if sr else none %}
      <div class="hb-row"><div class="hb-lbl">{{ name }} ({{ c|fmt }} invoice{{ 's' if c != 1 }})</div>
        <div class="hb-track"><div class="hb-bar gold" style="width:{{ (100 * amt / top_sup[0][1])|round(1) if top_sup[0][1] else 0 }}%">{% if pp is not none %}<div class="hb-paid" style="width:{{ [pp, 100]|min }}%"></div>{% endif %}</div></div>
        <div class="hb-val">{{ money(amt) }}{% if pp is not none %} &middot; <b>{{ pp|fmt }}% paid</b>{% endif %}</div></div>
      {% endfor %}
      {% if top_sup %}
      <div class="lg" style="margin-top: 6px;">
        <span><i style="background:var(--ok)"></i>Paid</span>
        <span><i style="background:var(--gold)"></i>Not yet paid</span>
        <span style="color:var(--mut)">green fill = the paid share of what the supplier has billed</span>
      </div>
      {% endif %}
      {% if not top_sup %}<div class="empty">No supplier activity.</div>{% endif %}
    </div>
  </div>
  <div class="foot">Part 5 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>





{#- ═══ PART 4 — OPEN OBLIGATIONS ═══════════════════════════════════════ -#}
{%- set po_sup = namespace(d={}, p={}) -%}
{%- for r in PO %}{% set k = r.supplier_name or '(Unknown supplier)' %}
  {%- set _ = po_sup.d.update({k: po_sup.d.get(k, 0) + (r.open_aed or 0)}) %}
  {%- set pd = po_sup.p.get(k, {}) %}{% set _ = pd.update({r.po_number: 1}) %}{% set _ = po_sup.p.update({k: pd}) %}{% endfor -%}
{%- set po_top = po_sup.d.items()|sort(attribute='1', reverse=true) -%}
{%- set po_total = PO|map(attribute='open_aed')|select('number')|sum -%}
{%- set po_sorted = (PO|rejectattr('open_aed', 'none')|sort(attribute='open_aed', reverse=true)|list) + (PO|selectattr('open_aed', 'none')|list) -%}
<div class="page">
  <div class="pt-band"><span class="pt-no">06</span><span class="pt-t">Open Obligations — Purchase Orders</span>
    <span class="pt-s">{{ PO|length|fmt }} funds-reserved PO lines, net of goods received</span></div>

  <div class="kpis">
    <div class="kpi k-enc"><div class="k-lbl">Open Obligation</div><div class="k-val">{{ money(po_total) }}</div><div class="k-sub">{{ (100 * po_total / O.budget)|round(1) if O.budget else '—' }}% of budget</div></div>
    <div class="kpi"><div class="k-lbl">PO Lines</div><div class="k-val">{{ PO|length|fmt }}</div><div class="k-sub">Reserved / Partially Liquidated</div></div>
    <div class="kpi"><div class="k-lbl">Suppliers</div><div class="k-val">{{ po_sup.d|length|fmt }}</div><div class="k-sub">holding open orders</div></div>
    <div class="kpi"><div class="k-lbl">Largest Single Line</div><div class="k-val">{{ money(po_sorted[0].open_aed) if po_sorted else '—' }}</div>
      <div class="k-sub">the biggest single open PO line{% if po_sorted %} — PO {{ po_sorted[0].po_number }}/{{ po_sorted[0].po_line }} &middot; {{ po_sorted[0].supplier_name or '—' }}{% endif %}</div></div>
  </div>

  <div class="charts">
    <div class="chart dep-bars">
      <div class="ch-t">Top 10 suppliers by open obligation <small>&mdash; (POs held &middot; share of the open obligation)</small></div>
      {% for name, amt in po_top[:10] %}
      {% set pcnt = po_sup.p.get(name, {})|length %}
      <div class="hb-row"><div class="hb-lbl">{{ name }} ({{ pcnt|fmt }} PO{{ 's' if pcnt != 1 }} &middot; {{ ((100 * amt / po_total)|round(1)|fmt ~ '%') if po_total else '—' }})</div>
        <div class="hb-track"><div class="hb-bar warn" style="width:{{ (100 * amt / po_top[0][1])|round(1) if po_top[0][1] else 0 }}%"></div></div>
        <div class="hb-val">{{ money(amt) }}</div></div>
      {% endfor %}
      {% if not po_top %}<div class="empty">No open purchase orders.</div>{% endif %}
    </div>
    <div class="chart dep-bars">
      <div class="ch-t">Largest open PO lines <small>&mdash; sorted by open amount</small></div>
      {% for r in po_sorted[:10] %}
      <div class="hb-row"><div class="hb-lbl">{{ r.po_number }}/{{ r.po_line }} &middot; {{ r.supplier_name or '—' }}</div>
        <div class="hb-track"><div class="hb-bar" style="width:{{ (100 * (r.open_aed or 0) / po_sorted[0].open_aed)|round(1) if po_sorted and po_sorted[0].open_aed else 0 }}%"></div></div>
        <div class="hb-val">{{ money(r.open_aed) }}</div></div>
      {% endfor %}
      {% if not PO %}<div class="empty">No open purchase orders.</div>{% endif %}
    </div>
  </div>
  <div class="tbl-note"><b>KPI guide</b> &mdash; <b>Largest Single Line</b>: the single biggest open purchase-order line &mdash; the largest amount still committed to a supplier on one PO line, net of goods already received. The full line register is in Appendix A.3.</div>
  <div class="foot">Part 6 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>



{#- ═══ PART 5 — OPEN COMMITMENTS ═══════════════════════════════════════ -#}
{%- set pr_total = PR|map(attribute='amount_aed')|select('number')|sum -%}
{%- set pr_sorted = (PR|rejectattr('amount_aed', 'none')|sort(attribute='amount_aed', reverse=true)|list) + (PR|selectattr('amount_aed', 'none')|list) -%}
{%- set SPR = S.sp_pr.data if S.sp_pr else [] -%}
<div class="page">
  <div class="pt-band"><span class="pt-no">07</span><span class="pt-t">Open Commitments — Purchase Requisitions</span>
    <span class="pt-s">{{ PR|length|fmt }} funds-reserved PR lines awaiting purchase orders</span></div>

  <div class="kpis">
    <div class="kpi k-enc"><div class="k-lbl">Open Commitment</div><div class="k-val">{{ money(pr_total) }}</div><div class="k-sub">{{ (100 * pr_total / O.budget)|round(1) if O.budget else '—' }}% of budget</div></div>
    <div class="kpi"><div class="k-lbl">PR Lines</div><div class="k-val">{{ PR|length|fmt }}</div><div class="k-sub">funds status Reserved</div></div>
    <div class="kpi"><div class="k-lbl">Largest Single Line</div><div class="k-val">{{ money(SPR[0].amount_aed) if SPR else (money(pr_sorted[0].amount_aed) if pr_sorted else '—') }}</div>
      <div class="k-sub">the biggest single open PR line{% if SPR %} — PR {{ SPR[0].pr_number }}{% if SPR[0].pr_line is not none %}({{ SPR[0].pr_line }}){% endif %} &middot; {{ SPR[0].requester or '—' }}{% elif pr_sorted %} — PR {{ pr_sorted[0].pr_number }}{% endif %}</div></div>
    <div class="kpi"><div class="k-lbl">Pipeline (PO + PR)</div><div class="k-val">{{ money((O.obligation_po or 0) + (O.commitment_pr or 0)) }}</div><div class="k-sub">total open encumbrance</div></div>
  </div>

  <div class="charts">
    <div class="chart sup-bars">
      <div class="ch-t">Largest open requisition lines <small>&mdash; PR number(Line) - Requester &middot; sorted by amount &middot; with days the funds have been reserved</small></div>
      {% for r in SPR %}
      <div class="hb-row"><div class="hb-lbl">{{ r.pr_number }}{% if r.pr_line is not none %}({{ r.pr_line }}){% endif %} - {{ r.requester or '—' }}</div>
        <div class="hb-track"><div class="hb-bar warn" style="width:{{ (100 * (r.amount_aed or 0) / SPR[0].amount_aed)|round(1) if SPR and SPR[0].amount_aed else 0 }}%"></div></div>
        <div class="hb-val">{{ money(r.amount_aed) }} &middot; {{ r.days_reserved|fmt }} days</div></div>
      {% endfor %}
      {% if not SPR %}<div class="empty">No open requisitions.</div>{% endif %}
    </div>
  </div>
  <div class="tbl-note"><b>KPI guide</b> &mdash; <b>Largest Single Line</b>: the single biggest open requisition line &mdash; the largest amount still reserved on one PR line that has not yet become a purchase order. <b>Days</b> counts from the line&rsquo;s funds-reservation (budget) date to the report date. The full line register is in Appendix A.4.</div>
  <div class="foot">Part 7 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>



{#- ═══ PART 6 — PENDING APPROVALS (PR & PO QUEUE) ══════════════════════ -#}
<div class="page">
  <div class="pt-band"><span class="pt-no">08</span><span class="pt-t">Pending Approvals — PR &amp; PO Queue</span>
    <span class="pt-s">documents PENDING APPROVAL in Fusion &middot; funds-reserved, non-zero lines</span></div>

  <div class="kpis">
    <div class="kpi"><div class="k-lbl">Pending Documents</div><div class="k-val">{{ POV.docs|fmt }}</div><div class="k-sub">{{ POV.lines|fmt }} budget lines</div></div>
    <div class="kpi"><div class="k-lbl">Requisitions (PR)</div><div class="k-val">{{ POV.pr_docs|fmt }}</div><div class="k-sub">{{ money(POV.amt_pr) }} AED</div></div>
    <div class="kpi"><div class="k-lbl">Purchase Orders (PO)</div><div class="k-val">{{ POV.po_docs|fmt }}</div><div class="k-sub">{{ money(POV.amt_po) }} AED</div></div>
    <div class="kpi k-enc"><div class="k-lbl">Pending Value</div><div class="k-val">{{ money(POV.amt_total) }}</div><div class="k-sub">already inside the open-encumbrance figures</div></div>
    <div class="kpi k-act"><div class="k-lbl">Average Wait</div><div class="k-val">{{ POV.avg_days|fmt }}</div><div class="k-sub">days pending &middot; oldest {{ POV.max_days|fmt }}</div></div>
    <div class="kpi {{ 'k-bad' if POV.over30_docs else 'k-ok' }}"><div class="k-lbl">Over 30 Days</div><div class="k-val {{ 'neg' if POV.over30_docs }}">{{ POV.over30_docs|fmt }}</div><div class="k-sub">documents &middot; {{ money(POV.over30_amt) }} AED</div></div>
  </div>

  <div class="charts">
    <div class="chart">
      <div class="ch-t">Aging — pending value and documents by days waiting <small>&mdash; sorted by amount</small></div>
      {% set PAGS = (PAG|rejectattr('amount_aed', 'none')|sort(attribute='amount_aed', reverse=true)|list) + (PAG|selectattr('amount_aed', 'none')|list) %}
      {% set pagmax = (PAGS|map(attribute='amount_aed')|select('number')|max) if PAGS else 0 %}
      {% for r in PAGS %}
      <div class="hb-row"><div class="hb-lbl">{{ r.bucket }} days</div>
        <div class="hb-track"><div class="hb-bar {{ 'bad' if r.bucket == '31+' else 'warn' if r.bucket == '16-30' else '' }}"
             style="width:{{ (100*(r.amount_aed or 0)/pagmax)|round(1) if pagmax else 0 }}%"></div></div>
        <div class="hb-val">{{ money(r.amount_aed) }} &middot; {{ r.docs|fmt }} docs</div></div>
      {% endfor %}
      {% if not PAG %}<div class="empty">No documents pending approval in scope.</div>{% endif %}
    </div>
    <div class="chart">
      <div class="ch-t">Top pending approvers by value held <small>&mdash; sorted by amount</small></div>
      {% set PAPS = (PAP|rejectattr('amount_aed', 'none')|sort(attribute='amount_aed', reverse=true)|list) + (PAP|selectattr('amount_aed', 'none')|list) %}
      {% set papmax = (PAPS|map(attribute='amount_aed')|select('number')|max) if PAPS else 0 %}
      {% for r in PAPS %}
      <div class="hb-row"><div class="hb-lbl">{{ (r.pending_with or '(Unassigned)')|string|truncate(26) }}</div>
        <div class="hb-track"><div class="hb-bar {{ 'bad' if r.max_days and r.max_days > 30 else 'warn' }}"
             style="width:{{ (100*(r.amount_aed or 0)/papmax)|round(1) if papmax else 0 }}%"></div></div>
        <div class="hb-val">{{ money(r.amount_aed) }} &middot; {{ r.docs|fmt }} docs</div></div>
      {% endfor %}
      {% if not PAP %}<div class="empty">No approver data.</div>{% endif %}
    </div>
  </div>

  <div class="sub-h">8.1 &nbsp; Pending value per approver <small>&mdash; top {{ PAP|length }} by amount held; the full registers live in the Encumbrances Pending Approval Briefing Book</small></div>
  {% if PAP %}
  <table class="data">
    <thead><tr><th>Pending With</th><th>Documents</th><th>Amount Held (AED)</th><th>Share of Pending Value</th><th>Longest Wait (days)</th><th>Oldest Submission</th></tr></thead>
    <tbody>
      {% for r in PAPS %}
      <tr><td>{{ r.pending_with or '(Unassigned)' }}</td>
        <td class="num">{{ r.docs|fmt }}</td>
        <td class="num">{{ r.amount_aed|fmt }}</td>
        <td class="num">{{ (100*(r.amount_aed or 0)/POV.amt_total)|round(1) if POV.amt_total else '—' }}%</td>
        <td class="num {{ 'neg' if r.max_days and r.max_days > 30 }}">{{ r.max_days|fmt }}</td>
        <td class="num">{{ dt(r.oldest_submitted) }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}<div class="empty">No documents pending approval for the selected criteria.</div>{% endif %}
  <div class="foot">Part 8 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>

{#- ═══ PART 9 — EXPENDITURE PLAN PERFORMANCE (v1.88.0) ════════════════ -#}
{%- set DPL = S.sp_dplan.data if S.sp_dplan else [] -%}
<div class="page">
  <div class="pt-band"><span class="pt-no">09</span><span class="pt-t">Expenditure Plan Performance</span>
    <span class="pt-s">actual spending vs the uploaded expenditure plan{{ ' &middot; YTD through ' ~ params.period if params.period else '' }}</span></div>

  <div class="kpis">
    <div class="kpi"><div class="k-lbl">Plan Performance</div><div class="k-val">{{ PCV.exec_pct|fmt if PCV.exec_pct is not none else '—' }}%</div><div class="k-sub">actual {{ money(PCV.actual_total) }} vs plan {{ money(PCV.ytd_plan) }}</div></div>
    <div class="kpi"><div class="k-lbl">YTD Plan</div><div class="k-val">{{ money(PCV.ytd_plan) }}</div><div class="k-sub">annual plan {{ money(PCV.annual_plan) }}</div></div>
    <div class="kpi"><div class="k-lbl">% of Budget Planned</div><div class="k-val">{{ PCV.coverage_pct|fmt if PCV.coverage_pct is not none else '—' }}%</div><div class="k-sub">of the {{ money(PCV.annual_budget) }} annual budget</div></div>
    <div class="kpi {{ 'k-bad' if PCV.lines_below else 'k-ok' }}"><div class="k-lbl">Below Plan</div><div class="k-val {{ 'neg' if PCV.lines_below }}">{{ PCV.lines_below|fmt }}</div><div class="k-sub">lines &middot; {{ money(PCV.below_amount) }} behind plan</div></div>
    <div class="kpi k-act"><div class="k-lbl">Ahead of Plan</div><div class="k-val">{{ PCV.lines_ahead|fmt }}</div><div class="k-sub">lines &middot; {{ money(PCV.ahead_amount) }} ahead</div></div>
    <div class="kpi k-enc"><div class="k-lbl">Plan Gap</div><div class="k-val">{{ money(PCV.plan_gap) }}</div><div class="k-sub">{{ PCV.lines_under|fmt }} under-planned &middot; {{ PCV.lines_unplanned|fmt }} unplanned lines</div></div>
  </div>

  <div class="charts">
    <div class="chart dep-bars">
      <div class="ch-t">Plan execution by Department — actual as % of the YTD plan (100% = on plan)</div>
      {% for r in DPL %}{% if r.ytd_plan %}
      <div class="hb-row"><div class="hb-lbl">{{ r.department or '—' }}{% if r.get('cost_centre') and r.cost_centre != '-' %} ({{ r.cost_centre }}){% endif %}</div>
        <div class="hb-track"><div class="hb-bar {{ 'bad' if r.plan_status == 'Ahead of plan' else 'warn' if r.plan_status == 'Below plan' else '' }}"
             style="width:{{ [((r.exec_pct or 0) / 1.4)|round(1), 100]|min }}%"></div></div>
        <div class="hb-val">{{ r.exec_pct|fmt }}% &middot; {{ r.plan_status }}</div></div>
      {% endif %}{% endfor %}
      {% if not DPL %}<div class="empty">No expenditure plan uploaded for the selected scope.</div>{% endif %}
    </div>
    <div class="chart dep-bars">
      <div class="ch-t">% of Budget Planned by Department — annual plan as % of the annual budget</div>
      {% for r in DPL %}
      <div class="hb-row"><div class="hb-lbl">{{ r.department or '—' }}{% if r.get('cost_centre') and r.cost_centre != '-' %} ({{ r.cost_centre }}){% endif %}</div>
        <div class="hb-track"><div class="hb-bar {{ 'warn' if r.coverage_pct is not none and r.coverage_pct < 95 else '' }}"
             style="width:{{ [((r.coverage_pct or 0) / 1.2)|round(1), 100]|min }}%"></div></div>
        <div class="hb-val">{{ r.coverage_pct|fmt if r.coverage_pct is not none else '—' }}% &middot; plan {{ money(r.annual_plan) }}</div></div>
      {% endfor %}
      {% if not DPL %}<div class="empty">No expenditure plan uploaded for the selected scope.</div>{% endif %}
    </div>
  </div>

  <div class="sub-h">9.1 &nbsp; Plan vs actual by Department</div>
  {% if DPL %}
  <table class="data">
    <thead><tr><th>Department</th><th>YTD Plan (AED)</th><th>Actual (AED)</th><th>Execution %</th><th>Status</th><th>Annual Plan (AED)</th><th>Annual Budget (AED)</th><th>% of Budget Planned</th></tr></thead>
    <tbody>
      {% for r in DPL %}
      <tr><td>{{ r.department or '—' }}{% if r.get('cost_centre') and r.cost_centre != '-' %} ({{ r.cost_centre }}){% endif %}</td>
        <td class="num">{{ r.ytd_plan|fmt }}</td>
        <td class="num">{{ r.actual_total|fmt }}</td>
        <td class="num">{{ r.exec_pct|fmt if r.exec_pct is not none else '—' }}%</td>
        <td class="{{ 'neg' if r.plan_status == 'Ahead of plan' }}">{{ r.plan_status }}</td>
        <td class="num">{{ r.annual_plan|fmt }}</td>
        <td class="num">{{ r.annual_budget|fmt }}</td>
        <td class="num">{{ r.coverage_pct|fmt if r.coverage_pct is not none else '—' }}%</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}<div class="empty">No expenditure plan uploaded for the selected scope.</div>{% endif %}


  <div class="foot">Part 9 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>

{#- ═══ APPENDIX — DETAILED REGISTERS ══════════════════════════════════ -#}
<div class="page">
  <div class="pt-band"><span class="pt-no">A</span><span class="pt-t">Appendix — Detailed Registers</span>
    <span class="pt-s">the full line-level registers behind Parts 05–07</span></div>
  <div class="sub-h">A.1 &nbsp; AP invoices charged directly to the budget <small>&mdash; {{ AP|length|fmt }} invoices, not PO-matched</small></div>
  {% if AP %}
  <table class="data">
    <thead><tr><th>Project</th><th>Project Name</th><th>Task</th><th>Expenditure Type</th>
      <th>Invoice #</th><th>Invoice Date</th><th>Supplier</th><th>Curr</th>
      <th>Charged AED</th><th>Payment</th><th>Paid %</th></tr></thead>
    <tbody>
      {% for r in AP %}
      <tr><td>{{ r.project_number }}</td><td>{{ (r.project_name or '—')|string|truncate(38) }}</td>
        <td>{{ r.task_number or '—' }}</td><td>{{ (r.expenditure_type or '—')|string|truncate(30) }}</td>
        <td>{{ r.invoice_number }}</td><td>{{ dt(r.invoice_date) }}</td>
        <td>{{ (r.supplier_name or '—')|string|truncate(34) }}</td><td>{{ r.currency or 'AED' }}</td>
        <td class="num">{{ r.matched_aed|fmt }}</td>
        <td><span class="pill {{ 'paid' if r.payment_status == 'Paid' else 'part' if r.payment_status == 'Partially Paid' else 'unp' }}">{{ r.payment_status }}</span></td><td class="num">{{ (r.paid_pct|fmt ~ '%') if r.paid_pct is not none else '—' }}</td></tr>
      {% endfor %}
    </tbody>
    <tfoot><tr><td colspan="8">Total — AP invoices</td><td class="num">{{ ap_total|fmt }}</td><td></td><td class="num"><b>{{ (X.get('ap_paid_pct')|fmt ~ '%') if X.get('ap_paid_pct') is not none else '' }}</b></td></tr></tfoot>
  </table>
  {% else %}<div class="empty">No direct AP invoices for the selected criteria.</div>{% endif %}
  <div class="foot">Appendix A.1 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>

<div class="page">
  <div class="sub-h">A.2 &nbsp; Goods receipts (GRN) <small>&mdash; {{ GRN|length|fmt }} receipt lines by purchase-order distribution</small></div>
  {% if GRN %}
  <table class="data">
    <thead><tr><th>Project</th><th>Project Name</th><th>Task</th><th>Expenditure Type</th>
      <th>PO #</th><th>Line</th><th>Supplier</th><th>Last Receipt</th><th>Receipts</th>
      <th>Received AED</th><th>Invoiced AED</th><th>Uninvoiced AED</th><th>Paid %</th></tr></thead>
    <tbody>
      {% for r in GRN %}
      <tr><td>{{ r.project_number }}</td><td>{{ (r.project_name or '—')|string|truncate(34) }}</td>
        <td>{{ r.task_number or '—' }}</td><td>{{ (r.expenditure_type or '—')|string|truncate(28) }}</td>
        <td>{{ r.po_number }}</td><td class="num">{{ r.po_line }}</td>
        <td>{{ (r.supplier_name or '—')|string|truncate(30) }}</td><td>{{ dt(r.last_receipt_date) }}</td>
        <td class="num">{{ r.receipt_lines|fmt }}</td><td class="num">{{ r.received_aed|fmt }}</td>
        <td class="num">{{ r.invoiced_aed|fmt }}</td><td class="num">{{ r.uninvoiced_aed|fmt }}</td><td class="num">{{ (r.paid_pct|fmt ~ '%') if r.paid_pct is not none else '—' }}</td></tr>
      {% endfor %}
    </tbody>
    <tfoot><tr><td colspan="9">Total — goods receipts</td>
      <td class="num">{{ grn_total|fmt }}</td>
      <td class="num">{{ GRN|map(attribute='invoiced_aed')|select('number')|sum|fmt }}</td>
      <td class="num">{{ GRN|map(attribute='uninvoiced_aed')|select('number')|sum|fmt }}</td><td class="num"><b>{{ (X.get('grn_paid_pct')|fmt ~ '%') if X.get('grn_paid_pct') is not none else '' }}</b></td></tr></tfoot>
  </table>
  {% else %}<div class="empty">No goods receipts for the selected criteria.</div>{% endif %}
  <div class="foot">Appendix A.2 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>

<div class="page">
  <div class="sub-h">A.3 &nbsp; Open purchase-order lines <small>&mdash; ordered by open amount, GRN-netted</small></div>
  {% if PO %}
  <table class="data">
    <thead><tr><th>Project</th><th>Project Name</th><th>Task</th><th>Expenditure Type</th>
      <th>PO #</th><th>Line</th><th>Budget Date</th><th>Supplier</th><th>Funds Status</th>
      <th>Line AED</th><th>Received AED</th><th>Open AED</th></tr></thead>
    <tbody>
      {% for r in po_sorted %}
      <tr><td>{{ r.project_number }}</td><td>{{ (r.project_name or '—')|string|truncate(32) }}</td>
        <td>{{ r.task_number or '—' }}</td><td>{{ (r.expenditure_type or '—')|string|truncate(28) }}</td>
        <td>{{ r.po_number }}</td><td class="num">{{ r.po_line }}</td><td>{{ dt(r.budget_date) }}</td>
        <td>{{ (r.supplier_name or '—')|string|truncate(30) }}</td><td>{{ r.funds_status }}</td>
        <td class="num">{{ r.line_aed|fmt }}</td><td class="num">{{ r.received_aed|fmt }}</td>
        <td class="num">{{ r.open_aed|fmt }}</td></tr>
      {% endfor %}
    </tbody>
    <tfoot><tr><td colspan="9">Total — open obligations</td>
      <td class="num">{{ PO|map(attribute='line_aed')|select('number')|sum|fmt }}</td>
      <td class="num">{{ PO|map(attribute='received_aed')|select('number')|sum|fmt }}</td>
      <td class="num">{{ po_total|fmt }}</td></tr></tfoot>
  </table>
  {% else %}<div class="empty">No open purchase orders for the selected criteria.</div>{% endif %}
  <div class="foot">Appendix A.3 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>

<div class="page">
  <div class="sub-h">A.4 &nbsp; Open purchase-requisition lines <small>&mdash; ordered by amount</small></div>
  {% if PR %}
  <table class="data">
    <thead><tr><th>Project</th><th>Project Name</th><th>Task</th><th>Expenditure Type</th>
      <th>PR #</th><th>Description</th><th>Budget Date</th><th>Curr</th>
      <th>Amount</th><th>Amount AED</th></tr></thead>
    <tbody>
      {% for r in pr_sorted %}
      <tr><td>{{ r.project_number }}</td><td>{{ (r.project_name or '—')|string|truncate(30) }}</td>
        <td>{{ r.task_number or '—' }}</td><td>{{ (r.expenditure_type or '—')|string|truncate(26) }}</td>
        <td>{{ r.pr_number }}</td><td>{{ (r.description or '—')|string|truncate(46) }}</td>
        <td>{{ dt(r.budget_date) }}</td><td>{{ r.currency or 'AED' }}</td>
        <td class="num">{{ r.distribution_amount|fmt }}</td><td class="num">{{ r.amount_aed|fmt }}</td></tr>
      {% endfor %}
    </tbody>
    <tfoot><tr><td colspan="9">Total — open commitments</td><td class="num">{{ pr_total|fmt }}</td></tr></tfoot>
  </table>
  {% else %}<div class="empty">No open requisitions for the selected criteria.</div>{% endif %}
  <div class="foot">Appendix A.4 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>

</body>
</html>
