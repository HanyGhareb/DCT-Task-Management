    <span class="pt-s">Top 5 Projects Budget by Department &middot; department {{ loop.index }} of {{ DEP|length }} &middot; Budget year {{ params.year }}{% if params.period %} &middot; YTD through {{ params.period }}{% endif %}</span></div>

  <div class="kpis">
    <div class="kpi"><div class="k-lbl">{{ 'YTD Budget' if params.period else 'Approved Budget' }}</div><div class="k-val">{{ money(d.budget_ytd) }}</div><div class="k-sub">AED &middot; Annual {{ money(d.budget_annual) }} &middot; {{ d.budget_lines|fmt }} lines</div></div>
    <div class="kpi"><div class="k-lbl">{{ 'YTD Plan' if params.period else 'Expenditure Plan' }}</div><div class="k-val">{{ money(d.plan_ytd) }}</div><div class="k-sub">AED{% if d.plan_annual is not none and d.plan_annual != d.plan_ytd %} &middot; Annual {{ money(d.plan_annual) }}{% endif %}{% if d.actual_plan_pct is not none %} &middot; <b style="white-space:nowrap">Actual vs Plan {{ d.actual_plan_pct|fmt }}%</b>{% endif %}</div></div>
    <div class="kpi k-act"><div class="k-lbl">Actual — AP</div><div class="k-val">{{ money(d.actual_ap) }}</div><div class="k-sub">AED</div></div>
    <div class="kpi k-act"><div class="k-lbl">Actual — GRN</div><div class="k-val">{{ money(d.actual_grn) }}</div><div class="k-sub">AED</div></div>
    <div class="kpi k-enc"><div class="k-lbl">Open Obligation (PO)</div><div class="k-val">{{ money(d.obligation_po) }}</div><div class="k-sub">AED</div></div>
    <div class="kpi k-enc"><div class="k-lbl">Open Commitment (PR)</div><div class="k-val">{{ money(d.commitment_pr) }}</div><div class="k-sub">AED</div></div>
    <div class="kpi {{ 'k-bad' if d.fund_available is not none and d.fund_available < 0 else 'k-ok' }}">
      <div class="k-lbl">Fund Available</div><div class="k-val {{ 'neg' if d.fund_available is not none and d.fund_available < 0 }}">{{ money(d.fund_available) }}</div>
      <div class="k-sub">{{ d.over_budget_lines|fmt }} lines over budget</div></div>
    <div class="kpi {{ 'k-bad' if d.actual_budget_pct is not none and d.actual_budget_pct > 100 else '' }}">
      <div class="k-lbl">Actual/Budget %</div><div class="k-val">{{ d.actual_budget_pct|fmt if d.actual_budget_pct is not none else '—' }}%</div>
      <div class="k-sub">YTD actual &divide; annual budget</div></div>
  </div>

  <div class="charts eq">
    <div class="chart comp" style="flex: 1.2 1 0">
      <div class="ch-t">Budget composition &mdash; where the {{ money(d.budget_ytd) }} stands</div>
      {% set B = d.budget_ytd or 0 %}
      {% if B > 0 %}
      {% set w_ap  = (100 * (d.actual_ap or 0) / B)|round(2) %}
      {% set w_grn = (100 * (d.actual_grn or 0) / B)|round(2) %}
      {% set w_po  = (100 * (d.obligation_po or 0) / B)|round(2) %}
      {% set w_pr  = (100 * (d.commitment_pr or 0) / B)|round(2) %}
      {% set w_fd  = 100 - w_ap - w_grn - w_po - w_pr %}
      <div class="stack">
        <div style="width:{{ [w_ap,0]|max }}%; background: var(--brand);">{% if w_ap >= 5.5 %}<span>{{ w_ap|round(1) }}%</span>{% endif %}</div>
        <div style="width:{{ [w_grn,0]|max }}%; background: var(--gold);">{% if w_grn >= 5.5 %}<span>{{ w_grn|round(1) }}%</span>{% endif %}</div>
        <div style="width:{{ [w_po,0]|max }}%; background: var(--enc);">{% if w_po >= 5.5 %}<span>{{ w_po|round(1) }}%</span>{% endif %}</div>
        <div style="width:{{ [w_pr,0]|max }}%; background: #D98E2B;">{% if w_pr >= 5.5 %}<span>{{ w_pr|round(1) }}%</span>{% endif %}</div>
        <div style="width:{{ [w_fd,0]|max }}%; background: #DDE7EB;">{% if w_fd >= 5.5 %}<span class="dk">{{ w_fd|round(1) }}%</span>{% endif %}</div>
      </div>
      <div class="lg">
        <span><i style="background:var(--brand)"></i>AP {{ w_ap }}%</span>
        <span><i style="background:var(--gold)"></i>GRN {{ w_grn }}%</span>
        <span><i style="background:var(--enc)"></i>Open PO {{ w_po }}%</span>
        <span><i style="background:#D98E2B"></i>Open PR {{ w_pr }}%</span>
        <span><i style="background:#DDE7EB"></i>Available {{ w_fd|round(2) }}%</span>
      </div>
      {% else %}<div class="empty">No approved budget in this department.</div>{% endif %}
    </div>
    <div class="chart dep-bars">
