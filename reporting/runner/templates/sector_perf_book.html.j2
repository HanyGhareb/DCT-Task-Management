<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ report_name }}</title>
{#- ── helpers ─────────────────────────────────────────────────────────── -#}
{%- set S = {} -%}
{%- for s in sections %}{% set _ = S.update({s.key: s}) %}{% endfor -%}
{%- set O = (S.overview.data[0] if S.overview and S.overview.data else {}) -%}
{%- set SEC = S.by_sector.data if S.by_sector else [] -%}
{%- set PRS = S.pressure.data if S.pressure else [] -%}
{%- set AP  = S.ap_lines.data if S.ap_lines else [] -%}
{%- set GRN = S.grn_lines.data if S.grn_lines else [] -%}
{%- set PO  = S.open_po.data if S.open_po else [] -%}
{%- set PR  = S.open_pr.data if S.open_pr else [] -%}
{%- set POV = (S.pend_ov.data[0] if S.pend_ov and S.pend_ov.data else {}) -%}
{%- set PAG = S.pend_aging.data if S.pend_aging else [] -%}
{%- set PAP = S.pend_approvers.data if S.pend_approvers else [] -%}
{%- set PLS = S.plan_sector.data if S.plan_sector else [] -%}
{%- set PLD = S.plan_dev.data if S.plan_dev else [] -%}
{%- set PCV = (S.plan_cov.data[0] if S.plan_cov and S.plan_cov.data else {}) -%}
{%- set TRM = S.terms.data if S.terms else [] -%}
{%- set X = (S.sp_extra.data[0] if S.sp_extra and S.sp_extra.data else {}) -%}
{%- set DEP = S.sp_dept.data if S.sp_dept else [] -%}
{%- set KND = S.sp_kind.data if S.sp_kind else [] -%}
{%- set T10 = S.sp_top10.data if S.sp_top10 else [] -%}
{%- set DKND = S.sp_dkind.data if S.sp_dkind else [] -%}
{%- set DPRJ = S.sp_dproj.data if S.sp_dproj else [] -%}
{%- set kinds = KND|rejectattr('kind','equalto','Total')|map(attribute='kind')|list -%}
{%- set tot_lbl = ('Total ' ~ kinds|join(' + ')) if kinds and kinds|length <= 2 else 'Total' -%}
{#- applied report scope — mirrors the GL Budget Utilization page filters -#}
{%- set flt = [] -%}
{%- if params.period %}{% set _ = flt.append('YTD through ' ~ params.period) %}{% endif -%}
{%- if params.sector %}{% set _ = flt.append('Sector: ' ~ params.sector) %}{% endif -%}
{%- if params.chapter %}{% set _ = flt.append('Chapters: ' ~ params.chapter|replace('|', ', ')) %}{% else %}{% set _ = flt.append('Opex + Capex chapters (default)') %}{% endif -%}
{%- if params.projecttype %}{% set _ = flt.append('Project type: ' ~ params.projecttype) %}{% endif -%}
{%- if params.costcenter %}{% set _ = flt.append('Cost centre: ' ~ params.costcenter) %}{% endif -%}
{%- if params.project %}{% set _ = flt.append('Project: ' ~ params.project) %}{% endif -%}
{%- if params.task %}{% set _ = flt.append('Task: ' ~ params.task) %}{% endif -%}
{%- if params.etype %}{% set _ = flt.append('Expenditure type: ' ~ params.etype) %}{% endif -%}
{%- if params.search %}{% set _ = flt.append('Search: ' ~ params.search) %}{% endif -%}
{%- if params.bu %}{% set _ = flt.append('Business unit: ' ~ params.bu|replace('|', ', ')) %}{% endif -%}
{%- set scopeline = flt|join(' · ') if flt else 'Whole organisation · Full year' -%}
{%- macro money(v) -%}
  {%- if v is none %}&mdash;
  {%- elif v|abs >= 1000000000 %}{{ (v/1000000000)|round(2)|fmt }}&nbsp;B
  {%- elif v|abs >= 1000000 %}{{ (v/1000000)|round(1)|fmt }}&nbsp;M
  {%- elif v|abs >= 1000 %}{{ (v/1000)|round(0)|int|fmt }}&nbsp;K
  {%- else %}{{ v|round(0)|int|fmt }}{%- endif -%}
{%- endmacro -%}
{%- macro dt(v) -%}{%- if v %}{{ v.strftime('%Y-%m-%d') if v.strftime is defined else v }}{% else %}&mdash;{% endif -%}{%- endmacro -%}
<style>
  :root { --brand: {{ brand|default('#1F6F8B') }}; --brand-d: #17596F; --gold: #B58900;
          --enc: #C25E10; --ok: #1E7B4D; --bad: #B3352B; --ink: #1F2933; --mut: #7B8794; }
  * { box-sizing: border-box; }
  body { font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif; color: var(--ink);
         margin: 0; font-size: 10px; }
  @page { size: A4 landscape; }
  .page { page-break-after: always; }
  .page:last-child { page-break-after: auto; }

  /* ── cover ─────────────────────────────────────────────────────────── */
  .cover { height: 166mm; position: relative; overflow: hidden;
           background: linear-gradient(135deg, #FFFFFF 55%, #F0F5F7 100%); }
  .cv-band { position: absolute; top: 0; left: 0; right: 0; height: 14mm;
             background: linear-gradient(90deg, var(--brand-d), var(--brand) 60%, #3E93AF); }
  .cv-band2 { position: absolute; bottom: 0; left: 0; right: 0; height: 6mm;
              background: linear-gradient(90deg, var(--gold), var(--enc)); }
  .cv-org { margin: 26mm 0 0 18mm; font-size: 12px; letter-spacing: .22em;
            text-transform: uppercase; color: var(--mut); }
  .cv-title { margin: 6mm 0 0 18mm; font-size: 46px; line-height: 1.08; font-weight: 800;
              color: var(--brand-d); }
  .cv-sub { margin: 4mm 0 0 18mm; font-size: 18px; color: var(--gold); font-weight: 700;
            letter-spacing: .04em; }
  .cv-sector { margin: 3mm 0 0 18mm; font-size: 14px; color: var(--brand-d); font-weight: 600; }
  .cv-scope { margin: 1.5mm 0 0 18mm; font-size: 11px; color: #5A6B73; font-weight: 600; }
  .cv-scope { margin: 10mm 0 0 18mm; display: flex; gap: 8px; flex-wrap: wrap; max-width: 200mm; }
  .cv-scope span { background: #fff; border: 1px solid #D3E0E5; border-left: 4px solid var(--brand);
                   border-radius: 3px; padding: 5px 12px; font-size: 11px; color: #33525E; }
  .cv-scope b { color: var(--brand-d); }
  .cv-desc { margin: 8mm 0 0 18mm; max-width: 150mm; font-size: 11px; line-height: 1.65;
             color: #52606D; }
  .cv-prep { position: absolute; bottom: 12mm; left: 18mm; background: #fff;
             border: 1px solid #D8E2E7; border-left: 5px solid var(--brand);
             border-radius: 5px; padding: 10px 20px 11px 14px;
             box-shadow: 0 2px 10px rgba(23,89,111,.12); }
  .cv-prep .pb-eyebrow { font-size: 8.5px; letter-spacing: .18em; text-transform: uppercase;
                         color: var(--mut); font-weight: 700; }
  .cv-prep b { display: block; font-size: 16.5px; color: var(--brand-d); margin-top: 3px;
               line-height: 1.2; }
  .cv-prep i { display: block; font-style: normal; font-size: 11px; color: #52606D; margin-top: 3px; }
  .cv-date { position: absolute; bottom: 12mm; right: 18mm; text-align: right;
             font-size: 10px; color: var(--mut); }
  .cv-date b { display: block; font-size: 12.5px; color: var(--ink); margin-top: 1px; }

  /* ── table of contents ─────────────────────────────────────────────── */
  .toc-h { border-bottom: 3px solid var(--brand); padding-bottom: 8px; margin-bottom: 12px; }
  .toc-h h2 { margin: 0; font-size: 22px; color: var(--brand-d); }
  .toc { width: 100%; border-collapse: collapse; }
  .toc td { padding: 9px 10px; border-bottom: 1px solid #E4E7EB; vertical-align: top; }
  .toc .no { width: 52px; font-size: 17px; font-weight: 800; color: var(--brand);
             font-variant-numeric: tabular-nums; }
  .toc .no span { display: inline-flex; align-items: center; justify-content: center;
                  width: 30px; height: 30px; border-radius: 50%; background: var(--brand);
                  color: #fff; font-size: 13px; font-weight: 800; }
  .toc .t { font-size: 13px; font-weight: 700; color: var(--ink); }
  .toc .d { font-size: 10px; color: var(--mut); margin-top: 2px; }
  .toc .n { width: 130px; text-align: right; font-size: 10px; color: #52606D;
            font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* ── terms & key definitions (rich text from the GL editor) ─────── */
  .terms-doc { margin: 6mm 2mm 0; font-size: 11px; line-height: 1.75; color: #2A3439; }
  .terms-doc h1, .terms-doc h2, .terms-doc h3 { color: var(--brand-d); margin: 4mm 0 2mm; }
  .terms-doc h1 { font-size: 15px; } .terms-doc h2 { font-size: 13px; } .terms-doc h3 { font-size: 12px; }
  .terms-doc p { margin: 0 0 2.2mm; }
  .terms-doc ul, .terms-doc ol { margin: 1mm 0 3mm; padding-inline-start: 7mm; }
  .terms-doc li { margin: 0 0 1.8mm; }
  .terms-doc strong { color: var(--brand-d); }
  .terms-doc blockquote { border-inline-start: 3px solid var(--gold); margin: 2mm 0; padding: 1mm 4mm; color: #5A6B73; }
  .terms-doc .ql-align-center { text-align: center; }
  .terms-doc .ql-align-right { text-align: right; }
  .terms-doc .ql-align-justify { text-align: justify; }
  .terms-doc .ql-direction-rtl { direction: rtl; text-align: right; }
  .terms-doc .ql-indent-1 { padding-inline-start: 8mm; }
  .terms-doc .ql-indent-2 { padding-inline-start: 16mm; }
  .terms-doc .ql-indent-3 { padding-inline-start: 24mm; }
  .terms-doc .ql-size-small { font-size: 9px; }
  .terms-doc .ql-size-large { font-size: 14px; }
  .terms-doc .ql-size-huge { font-size: 18px; }
  /* ── overview table cards (Sector Overview + By Department) ─────── */
  .chart table.data { margin-top: 2mm; }
  .chart .data th { text-align: center; }
  .dep-bars .hb-lbl { flex: 0 0 230px; white-space: normal; line-height: 1.15; font-size: 8px; }
  .sup-bars .hb-lbl { flex: 0 0 420px; white-space: normal; line-height: 1.15; }
  .sup-bars .hb-val { flex: 0 0 132px; }
  .hb-paid { height: 100%; background: var(--ok); border-radius: 2px 0 0 2px; min-width: 0; }
  .ch-t small { font-weight: 400; color: var(--mut); }
  .tbl-note { margin-top: 4px; font-size: 8px; color: #7A8794; }
  .data tr.tot td { font-weight: 700; background: #EFF5F2; border-top: 1.5px solid var(--brand); }
  /* ── part banner + section furniture ───────────────────────────────── */
  .pt-band { display: flex; align-items: center; gap: 12px; background:
             linear-gradient(90deg, var(--brand-d), var(--brand)); color: #fff;
             border-radius: 4px; padding: 8px 14px; margin-bottom: 10px; }
  .pt-no { display: flex; align-items: center; justify-content: center; flex: 0 0 34px;
           width: 34px; height: 34px; border-radius: 50%; background: #fff;
           color: var(--brand-d); font-size: 15px; font-weight: 800; }
  .pt-t { font-size: 16px; font-weight: 700; }
  .pt-s { margin-left: auto; font-size: 9.5px; opacity: .85; text-align: right; }
  .sub-h { border-left: 4px solid var(--brand); background: #F0F5F7; padding: 4px 8px;
           font-size: 11.5px; font-weight: 700; color: #24404B; margin: 12px 0 6px; }
  .sub-h small { font-weight: 400; color: var(--mut); }

  /* ── KPI tiles ─────────────────────────────────────────────────────── */
  .kpis { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 10px; }
  .kpi { flex: 1 1 100px; border: 1px solid #D8E2E7; border-top: 3px solid var(--brand);
         border-radius: 4px; padding: 6px 9px; background: #FBFDFE; }
  .kpi.k-act { border-top-color: var(--gold); }
  .kpi.k-enc { border-top-color: var(--enc); }
  .kpi.k-ok { border-top-color: var(--ok); }
  .kpi.k-bad { border-top-color: var(--bad); }
  .k-lbl { font-size: 8px; letter-spacing: .06em; text-transform: uppercase; color: var(--mut); }
  .k-val { font-size: 15px; font-weight: 800; margin-top: 1px; font-variant-numeric: tabular-nums; }
  .k-sub { font-size: 8.5px; color: var(--mut); margin-top: 1px; }
  .neg { color: var(--bad); }

  /* ── charts (pure CSS/HTML — deterministic in print) ───────────────── */
  .charts { display: flex; gap: 14px; align-items: flex-start; }
  .chart { flex: 1 1 0; border: 1px solid #E0E8EC; border-radius: 4px; padding: 8px 10px;
           background: #fff; }
  .ch-t { font-size: 10px; font-weight: 700; color: #24404B; margin-bottom: 6px; }
  .hb-row { display: flex; align-items: center; gap: 6px; margin: 3px 0; }
  .hb-lbl { flex: 0 0 118px; font-size: 8.5px; color: #3E4C59; text-align: right;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hb-track { flex: 1 1 0; background: #EEF2F5; border-radius: 2px; height: 9px; }
  .hb-bar { height: 9px; border-radius: 2px; background: var(--brand); min-width: 1px; }
  .hb-bar.warn { background: var(--enc); } .hb-bar.bad { background: var(--bad); }
  .hb-bar.gold { background: var(--gold); } .hb-bar.ok { background: var(--ok); }
  .hb-val { flex: 0 0 64px; font-size: 8.5px; color: #33525E; font-variant-numeric: tabular-nums;
            white-space: nowrap; }
  /* stacked composition bar */
  .stack { display: flex; height: 20px; border-radius: 3px; overflow: hidden; margin: 4px 0 6px; }
  .stack div { height: 20px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  /* composition card stretched to the height of its neighbour (user 2026-09-06) */
  .charts.eq { align-items: stretch; }
  .chart.comp { display: flex; flex-direction: column; }
  .chart.comp .stack { flex: 1 1 auto; height: auto; min-height: 20px; }
  .chart.comp .stack div { height: auto; }
  .stack span { font-size: 8px; font-weight: 700; color: #fff; text-shadow: 0 1px 1px rgba(0,0,0,.3); }
  .stack span.dk { color: #44565F; text-shadow: none; }
  .lg { display: flex; gap: 12px; flex-wrap: wrap; font-size: 8.5px; color: #3E4C59; }
  .lg i { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 4px; }
  /* monthly column chart */
  .cols { display: flex; align-items: flex-end; gap: 8px; height: 110px; padding-top: 4px; }
  .col-g { flex: 1 1 0; display: flex; align-items: flex-end; gap: 2px; height: 100px;
           border-bottom: 2px solid #CBD2D9; }
  .col-g div { flex: 1 1 0; border-radius: 2px 2px 0 0; }
  .col-ap { background: var(--brand); } .col-grn { background: var(--gold); }
  .col-lbl { font-size: 7.5px; color: var(--mut); text-align: center; margin-top: 3px; }

  /* ── data tables ───────────────────────────────────────────────────── */
  table.data { border-collapse: collapse; width: 100%; }
  table.data thead th { background: var(--brand); color: #fff; font-weight: 600; text-align: left;
                        padding: 4px 6px; font-size: 8.5px; border: 1px solid var(--brand-d); }
  table.data tbody td { padding: 3px 6px; border: 1px solid #E4E7EB; vertical-align: top;
                        font-size: 8.5px; }
  table.data tbody tr:nth-child(even) td { background: #F5F7FA; }
  td.num, tfoot td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  table.data tfoot td { padding: 4px 6px; border: 1px solid #CBD2D9; background: #E3ECEF;
                        font-weight: 700; color: #24404B; font-size: 8.5px; }
  .empty { padding: 16px; text-align: center; color: var(--mut); font-style: italic;
           border: 1px dashed #D3DCE2; }
  .pill { display: inline-block; border-radius: 8px; padding: 0 6px; font-size: 8px; }
  .pill.paid { background: #E1F3E8; color: var(--ok); }
  .pill.part { background: #FCF0DE; color: #8A5E00; }
  .pill.unp  { background: #FBE4E1; color: var(--bad); }

  /* ── insights ──────────────────────────────────────────────────────── */
  .ins { border: 1px solid #E0E8EC; border-left: 4px solid var(--brand); border-radius: 4px;
         background: #FBFDFE; padding: 9px 12px; margin-bottom: 8px; }
  .ins .i-t { font-size: 11px; font-weight: 700; color: var(--brand-d); margin-bottom: 2px; }
  .ins .i-b { font-size: 10px; line-height: 1.55; color: #3E4C59; }
  .ins b { color: var(--ink); }
  .i-good { color: var(--ok) !important; font-weight: 700; }
  .i-bad { color: var(--bad) !important; font-weight: 700; }
  .meth { margin-top: 12px; border: 1px dashed #C9D6DC; border-radius: 4px; padding: 9px 12px;
          background: #F7FAFB; }
  .meth h4 { margin: 0 0 5px; font-size: 10px; color: var(--brand-d); text-transform: uppercase;
             letter-spacing: .08em; }
  .meth div { font-size: 9px; color: #52606D; line-height: 1.6; }
  .meth b { color: #33525E; }
  .foot { margin-top: 10px; font-size: 8px; color: #9AA5B1; text-align: center; }
</style>
</head>
<body>

{#- ── per-page chrome (Sector Performance Report) ─────────────────────────
    render_pdf.py extracts these two <template> blocks and hands them to
    Chromium's displayHeaderFooter, so the DCT logo (top right) and the
    copyright line repeat on EVERY printed page, drawn inside the page
    margins where flowing content can never overlap them. data-margin sets
    that side's page margin to make the room. -#}
<template id="pdf-header" data-margin="24mm">
  <div style="width:100%; box-sizing:border-box; padding:2mm 12mm 0; display:flex; justify-content:flex-end;">
    <img src="data:image/png;base64," style="height:13mm; width:auto;">
  </div>
</template>
<template id="pdf-footer" data-margin="16mm">
  <div style="width:100%; box-sizing:border-box; padding:0 12mm 4mm; text-align:center; font-family:'Segoe UI','Helvetica Neue',Arial,sans-serif; font-size:7.5px; color:#9AA5B1;">
    &copy; {{ generated_at[:4] }} Department of Culture and Tourism &mdash; Abu Dhabi. All rights reserved. Confidential &mdash; for internal use only.
  </div>
</template>


{#- ═══ COVER ═══════════════════════════════════════════════════════════ -#}
<div class="page cover">
  <div class="cv-band"></div>
  <div class="cv-org">Oracle Fusion i-Finance &middot; Reporting Platform</div>
  <div class="cv-title">Sector Performance Report</div>
  <div class="cv-sub">{% if params.period %}YTD {{ params.period }}{% else %}Budget Year {{ params.year }}{% endif %}</div>
  <div class="cv-sector">Sector: {{ params.sector|replace('|', ', ') if params.sector else 'All Sectors' }}</div>
  <div class="cv-scope">Scope: {{ kinds|join(' + ') if kinds else 'Opex + Capex' }}</div>
  <div class="cv-prep">
    <div class="pb-eyebrow">Prepared by</div>
    <b>Financial Planning and Reporting</b>
    <i>Finance Department</i>
  </div>
  <div class="cv-band2"></div>
</div>

{#- ═══ INDEX ═══════════════════════════════════════════════════════════ -#}
<div class="page">
  <div class="toc-h"><h2>Contents</h2></div>
  <table class="toc">
    <tr><td class="no"><span>01</span></td>
        <td><div class="t">Terms and Key definitions</div>
            <div class="d">Definitions of the key figures and terms used throughout this report — YTD budget, actual, plan, encumbrance, fund available and the utilization ratios.</div></td>
        <td class="n">&nbsp;</td></tr>
    <tr><td class="no"><span>02</span></td>
        <td><div class="t">Budget Utilization Overview</div>
            <div class="d">Key indicators for the year, budget composition, department utilization and the sector overview by expenditure kind.</div></td>
        <td class="n">{{ DEP|length }} departments &middot; {{ O.budget_lines|fmt if O.budget_lines is not none else '—' }} budget lines</td></tr>
    <tr><td class="no"><span>03</span></td>
        <td><div class="t">Top 10 Projects Budget</div>
            <div class="d">The ten largest task budget lines in scope by annual budget, with plan, actual, encumbrance, remaining funds and the utilization ratios.</div></td>
        <td class="n">{{ T10|length }} budget lines</td></tr>
    <tr><td class="no"><span>04</span></td>
        <td><div class="t">Top 5 Projects Budget by Department</div>
            <div class="d">One page per department: its budget-utilization overview with the five largest projects by budget — utilization bars and the project figures.</div></td>
        <td class="n">{{ DEP|length }} departments</td></tr>
    <tr><td class="no"><span>05</span></td>
        <td><div class="t">Actuals — Supplier Invoices &amp; Goods Receipts</div>
            <div class="d">Every actual charged to the budget: direct AP invoices (not PO-matched) and GRN goods receipts, with paid coverage and supplier concentration.</div></td>
        <td class="n">{{ AP|length|fmt }} invoices &middot; {{ GRN|length|fmt }} receipt lines</td></tr>
    <tr><td class="no"><span>06</span></td>
        <td><div class="t">Open Obligations — Purchase Orders</div>
            <div class="d">Funds-reserved purchase-order lines net of goods received: what remains contractually committed to suppliers.</div></td>
        <td class="n">{{ PO|length|fmt }} PO lines</td></tr>
    <tr><td class="no"><span>07</span></td>
        <td><div class="t">Open Commitments — Purchase Requisitions</div>
            <div class="d">Funds-reserved requisition lines not yet converted to purchase orders: demand in the pipeline.</div></td>
        <td class="n">{{ PR|length|fmt }} PR lines</td></tr>
    <tr><td class="no"><span>08</span></td>
        <td><div class="t">Pending Approvals — PR &amp; PO Queue</div>
            <div class="d">Demand still waiting in the Fusion approval queue (funds-reserved): how much, how long it has been waiting, and who is holding it — tomorrow's encumbrance movements.</div></td>
        <td class="n">{{ POV.docs|fmt if POV.docs is not none else '—' }} documents &middot; {{ (POV.amt_total/1000000)|round(1)|fmt if POV.amt_total else '—' }} M AED</td></tr>
    <tr><td class="no"><span>09</span></td>
        <td><div class="t">Expenditure Plan Performance</div>
            <div class="d">Actual spending measured against the uploaded expenditure plan (plan vs actual by department) and how much of the annual budget the plan covers.</div></td>
        <td class="n">{{ PCV.exec_pct|fmt if PCV.exec_pct is not none else '—' }}% of plan &middot; {{ PCV.coverage_pct|fmt if PCV.coverage_pct is not none else '—' }}% coverage</td></tr>
    <tr><td class="no"><span>A</span></td>
        <td><div class="t">Appendix — Detailed Registers</div>
            <div class="d">The full line-level registers behind Parts 05–07: direct AP invoices and goods receipts (with paid %), open purchase-order lines and open purchase-requisition lines.</div></td>
        <td class="n">{{ AP|length|fmt }} invoices &middot; {{ GRN|length|fmt }} receipts &middot; {{ PO|length|fmt }} PO &middot; {{ PR|length|fmt }} PR lines</td></tr>
  </table>
  <div class="foot">{{ meta }} &middot; times in GST (UTC+04:00, Asia/Dubai)</div>
</div>

{#- ═══ PART 1 — TERMS AND KEY DEFINITIONS ═══════════════════════ -#}
<div class="page">
  <div class="pt-band"><span class="pt-no">01</span><span class="pt-t">Terms and Key definitions</span>
    <span class="pt-s">{% if params.period %}In force at YTD {{ params.period }}{% else %}Budget year {{ params.year }}{% endif %}</span></div>
  {% if TRM %}
  {% for r in TRM %}
  <div class="terms-doc">{{ r.content_html|safe if r.content_html else '' }}</div>
  {% endfor %}
  {% else %}
  <div class="empty">No active Terms and Key definitions document for this reporting period.</div>
  {% endif %}
  <div class="foot">Part 1 &middot; Sector Performance Report &middot; {{ params.year }}</div>
</div>

{#- ═══ PART 2 — OVERVIEW ═══════════════════════════════════════════════ -#}
{% set spent = (O.actual_total or 0) + (O.obligation_po or 0) + (O.commitment_pr or 0) %}
<div class="page">
  <div class="pt-band"><span class="pt-no">02</span><span class="pt-t">Budget Utilization Overview</span>
    <span class="pt-s">Budget year {{ params.year }} &middot; {{ scopeline|truncate(150) }}</span></div>

  <div class="kpis">
    <div class="kpi"><div class="k-lbl">{{ 'YTD Budget' if params.period else 'Approved Budget' }}</div><div class="k-val">{{ money(O.budget) }}</div><div class="k-sub">AED &middot; {% if O.budget_annual is not none and O.budget_annual != O.budget %}Annual {{ money(O.budget_annual) }} &middot; {% endif %}{{ O.budget_lines|fmt }} lines</div></div>
    <div class="kpi"><div class="k-lbl">{{ 'YTD Plan' if params.period else 'Expenditure Plan' }}</div><div class="k-val">{{ money(O.plan_approved_ytd) }}</div><div class="k-sub">AED{% if O.plan_approved_annual is not none and O.plan_approved_annual != O.plan_approved_ytd %} &middot; Annual {{ money(O.plan_approved_annual) }}{% endif %}{% if O.plan_revised_annual %} &middot; Revised {{ money(O.plan_revised_ytd) }}{% endif %}{% if X.get('actual_vs_plan_pct') is not none %} &middot; <b style="white-space:nowrap">Actual vs Plan {{ X.get('actual_vs_plan_pct')|fmt }}%</b>{% endif %}</div></div>
    <div class="kpi k-act"><div class="k-lbl">Actual — AP</div><div class="k-val">{{ money(O.actual_ap) }}</div><div class="k-sub">{{ AP|length|fmt }} invoices{% if X.get('ap_paid_pct') is not none %} &middot; <b>{{ X.get('ap_paid_pct')|fmt }}% paid</b>{% endif %}</div></div>
    <div class="kpi k-act"><div class="k-lbl">Actual — GRN</div><div class="k-val">{{ money(O.actual_grn) }}</div><div class="k-sub">{{ GRN|length|fmt }} receipt lines{% if X.get('grn_paid_pct') is not none %} &middot; <b>{{ X.get('grn_paid_pct')|fmt }}% paid</b>{% endif %}</div></div>
    <div class="kpi k-enc"><div class="k-lbl">Open Obligation (PO)</div><div class="k-val">{{ money(O.obligation_po) }}</div><div class="k-sub">{{ PO|length|fmt }} PO lines</div></div>
    <div class="kpi k-enc"><div class="k-lbl">Open Commitment (PR)</div><div class="k-val">{{ money(O.commitment_pr) }}</div><div class="k-sub">{{ PR|length|fmt }} PR lines</div></div>
    <div class="kpi {{ 'k-bad' if O.fund_available is not none and O.fund_available < 0 else 'k-ok' }}">
      <div class="k-lbl">Fund Available</div><div class="k-val {{ 'neg' if O.fund_available is not none and O.fund_available < 0 }}">{{ money(O.fund_available) }}</div>
      <div class="k-sub">{{ O.over_budget_lines|fmt }} lines over budget</div></div>
    <div class="kpi {{ 'k-bad' if X.get('actual_budget_pct') is not none and X.get('actual_budget_pct') > 100 else '' }}">
      <div class="k-lbl">Actual/Budget %</div><div class="k-val">{{ X.get('actual_budget_pct')|fmt if X.get('actual_budget_pct') is not none else '—' }}%</div>
      <div class="k-sub">YTD actual &divide; annual budget</div></div>
  </div>

  <div class="charts eq">
    <div class="chart comp" style="flex: 1.2 1 0">
      <div class="ch-t">Budget composition — where the {{ money(O.budget) }} stands</div>
      {% set B = O.budget or 0 %}
      {% if B > 0 %}
      {% set w_ap  = (100 * (O.actual_ap or 0) / B)|round(2) %}
      {% set w_grn = (100 * (O.actual_grn or 0) / B)|round(2) %}
      {% set w_po  = (100 * (O.obligation_po or 0) / B)|round(2) %}
      {% set w_pr  = (100 * (O.commitment_pr or 0) / B)|round(2) %}
      {% set w_fd  = 100 - w_ap - w_grn - w_po - w_pr %}
      <div class="stack">
        <div style="width:{{ [w_ap,0]|max }}%; background: var(--brand);">{% if w_ap >= 5.5 %}<span>{{ w_ap|round(1) }}%</span>{% endif %}</div>
        <div style="width:{{ [w_grn,0]|max }}%; background: var(--gold);">{% if w_grn >= 5.5 %}<span>{{ w_grn|round(1) }}%</span>{% endif %}</div>
        <div style="width:{{ [w_po,0]|max }}%; background: var(--enc);">{% if w_po >= 5.5 %}<span>{{ w_po|round(1) }}%</span>{% endif %}</div>
        <div style="width:{{ [w_pr,0]|max }}%; background: #D98E2B;">{% if w_pr >= 5.5 %}<span>{{ w_pr|round(1) }}%</span>{% endif %}</div>
        <div style="width:{{ [w_fd,0]|max }}%; background: #DDE7EB;">{% if w_fd >= 5.5 %}<span class="dk">{{ w_fd|round(1) }}%</span>{% endif %}</div>
      </div>
      <div class="lg">
        <span><i style="background:var(--brand)"></i>AP {{ w_ap }}%</span>
        <span><i style="background:var(--gold)"></i>GRN {{ w_grn }}%</span>
        <span><i style="background:var(--enc)"></i>Open PO {{ w_po }}%</span>
        <span><i style="background:#D98E2B"></i>Open PR {{ w_pr }}%</span>
        <span><i style="background:#DDE7EB"></i>Available {{ w_fd|round(2) }}%</span>
      </div>
      {% else %}<div class="empty">No approved budget in scope.</div>{% endif %}
    </div>
    <div class="chart dep-bars">
      <div class="ch-t">Utilization by Department &mdash; Actual/Budget %, largest budget first{% if DEP|length > 10 %} (top 10 of {{ DEP|length }}){% endif %}</div>
      {% for r in DEP[:10] %}
      {% set u = r.actual_budget_pct or 0 %}
      <div class="hb-row"><div class="hb-lbl">{{ r.department or '—' }}{% if r.get('cost_centre') and r.cost_centre != '-' %} ({{ r.cost_centre }}){% endif %}</div>
        <div class="hb-track"><div class="hb-bar {{ 'bad' if u > 100 else 'warn' if u > 85 else '' }}"
             style="width:{{ [u, 100]|min|round(1) }}%"></div></div>
        <div class="hb-val">{{ u|fmt }}%</div></div>
      {% endfor %}
      {% if not DEP %}<div class="empty">No department data.</div>{% endif %}
    </div>
  </div>

  <div class="charts">
    <div class="chart">
      <div class="ch-t">Sector Overview &mdash; {{ kinds|join(' / ') if kinds else 'Opex / Capex' }}</div>
      {% if KND %}
      <table class="data">
        <thead><tr><th></th><th class="num">Annual Budget</th><th class="num">YTD Actual</th><th class="num">YTD Plan</th><th class="num">Actual/Budget %</th><th class="num">Actual/Plan %</th></tr></thead>
        <tbody>
          {% for r in KND %}
          <tr{% if r.kind == 'Total' %} class="tot"{% endif %}><td>{{ tot_lbl if r.kind == 'Total' else r.kind }}</td>
            <td class="num">{{ money(r.budget_annual) }}</td><td class="num">{{ money(r.actual_ytd) }}</td>
            <td class="num">{{ money(r.plan_ytd) }}</td>
            <td class="num">{{ (r.actual_budget_pct|fmt ~ '%') if r.actual_budget_pct is not none else '—' }}</td>
            <td class="num">{{ (r.actual_plan_pct|fmt ~ '%') if r.actual_plan_pct is not none else '—' }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% set ktot_ba = KND|selectattr('kind','equalto','Total')|map(attribute='budget_annual')|select('number')|sum %}
      {% set kexcl = (O.budget_annual or 0) - ktot_ba %}
      {% if kexcl|abs > 0.005 %}<div class="tbl-note">A further {{ money(kexcl) }} of the {{ money(O.budget_annual) }} annual budget is not attributed to an expenditure kind in this table.</div>{% endif %}
      {% else %}<div class="empty">No Opex/Capex budget lines in scope.</div>{% endif %}
    </div>
    <div class="chart" style="flex: 1.35 1 0">
      <div class="ch-t">Budget overview by Department{% if DEP|length > 12 %} &mdash; top 12 of {{ DEP|length }} by budget{% endif %}</div>
      {% if DEP %}
      <table class="data">
        <thead><tr><th>Department</th><th class="num">Annual Budget</th><th class="num">Actual</th><th class="num">Encumbrance</th><th class="num">Fund Available</th><th class="num">Actual/Budget %</th><th class="num">Actual/Plan %</th></tr></thead>
        <tbody>
          {% for r in DEP[:12] %}
          <tr><td>{{ r.department or '—' }}{% if r.get('cost_centre') and r.cost_centre != '-' %} ({{ r.cost_centre }}){% endif %}</td><td class="num">{{ money(r.budget_annual) }}</td>
            <td class="num">{{ money(r.actual_total) }}</td><td class="num">{{ money(r.encumbrance) }}</td>
            <td class="num {{ 'neg' if r.fund_available is not none and r.fund_available < 0 }}">{{ money(r.fund_available) }}</td>
            <td class="num">{{ (r.actual_budget_pct|fmt ~ '%') if r.actual_budget_pct is not none else '—' }}</td>
            <td class="num">{{ (r.actual_plan_pct|fmt ~ '%') if r.actual_plan_pct is not none else '—' }}</td></tr>
          {% endfor %}
        </tbody>
        {% set d_ba = DEP|map(attribute='budget_annual')|select('number')|sum %}
        {% set d_at = DEP|map(attribute='actual_total')|select('number')|sum %}
        {% set d_en = DEP|map(attribute='encumbrance')|select('number')|sum %}
        {% set d_fa = DEP|map(attribute='fund_available')|select('number')|sum %}
        {% set d_pl = DEP|map(attribute='plan_ytd')|select('number')|sum %}
        <tfoot><tr><td>Total &mdash; {{ DEP|length }} departments</td>
          <td class="num">{{ money(d_ba) }}</td><td class="num">{{ money(d_at) }}</td>
          <td class="num">{{ money(d_en) }}</td>
          <td class="num {{ 'neg' if d_fa < 0 }}">{{ money(d_fa) }}</td>
          <td class="num">{{ ((100*d_at/d_ba)|round(1)|fmt ~ '%') if d_ba else '—' }}</td>
          <td class="num">{{ ((100*d_at/d_pl)|round(1)|fmt ~ '%') if d_pl else '—' }}</td></tr></tfoot>
      </table>
      {% else %}<div class="empty">No department data.</div>{% endif %}
    </div>
  </div>
  <div class="foot">Part 2 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>

{#- ═══ PART 3 — TOP 10 PROJECTS BUDGET ════════════════════════════════ -#}
<div class="page">
  <div class="pt-band"><span class="pt-no">03</span><span class="pt-t">Top 10 Projects Budget</span>
    <span class="pt-s">largest task budget lines by annual budget &middot; Budget year {{ params.year }}{% if params.period %} &middot; YTD through {{ params.period }}{% endif %}</span></div>
  {% if T10 %}
  <div class="charts"><div class="chart">
    <div class="ch-t">Top {{ T10|length }} projects budget &mdash; all figures AED</div>
    <table class="data">
      <thead><tr><th>Project Number</th><th>Project Name</th><th>Task</th>
        <th class="num">Annual Budget</th><th class="num">{{ 'YTD Plan' if params.period else 'Plan' }}</th>
        <th class="num">Actual</th><th class="num">Encumbrance</th><th class="num">Fund Available</th>
        <th class="num">Actual/Budget %</th><th class="num">Actual/Plan %</th></tr></thead>
      <tbody>
        {% for r in T10 %}
        <tr><td>{{ r.project_number }}</td><td>{{ r.project_name or '—' }}</td><td>{{ r.task_disp or '—' }}</td>
          <td class="num">{{ r.budget_annual|fmt }}</td><td class="num">{{ r.plan_ytd|fmt }}</td>
          <td class="num">{{ r.actual_ytd|fmt }}</td><td class="num">{{ r.encumbrance|fmt }}</td>
          <td class="num {{ 'neg' if r.fund_available is not none and r.fund_available < 0 }}">{{ r.fund_available|fmt }}</td>
          <td class="num">{{ (r.actual_budget_pct|fmt ~ '%') if r.actual_budget_pct is not none else '—' }}</td>
          <td class="num">{{ (r.actual_plan_pct|fmt ~ '%') if r.actual_plan_pct is not none else '—' }}</td></tr>
        {% endfor %}
      </tbody>
      {% set t_ba = T10|map(attribute='budget_annual')|select('number')|sum %}
      {% set t_pl = T10|map(attribute='plan_ytd')|select('number')|sum %}
      {% set t_ac = T10|map(attribute='actual_ytd')|select('number')|sum %}
      {% set t_en = T10|map(attribute='encumbrance')|select('number')|sum %}
      {% set t_fa = T10|map(attribute='fund_available')|select('number')|sum %}
      <tfoot><tr><td colspan="3">Total &mdash; top {{ T10|length }} budget lines</td>
        <td class="num">{{ t_ba|fmt }}</td><td class="num">{{ t_pl|fmt }}</td>
        <td class="num">{{ t_ac|fmt }}</td><td class="num">{{ t_en|fmt }}</td>
        <td class="num {{ 'neg' if t_fa < 0 }}">{{ t_fa|fmt }}</td>
        <td class="num">{{ ((100*t_ac/t_ba)|round(1)|fmt ~ '%') if t_ba else '—' }}</td>
        <td class="num">{{ ((100*t_ac/t_pl)|round(1)|fmt ~ '%') if t_pl else '—' }}</td></tr></tfoot>
    </table>
    <div class="tbl-note">The {{ T10|length }} largest task budget lines in scope, ordered by annual budget. The Task column
      shows the task number, or the task name where the task number is a plain sequence code; the Total row&rsquo;s ratios are
      recomputed from the summed figures.</div>
  </div></div>
  {% else %}<div class="empty">No budget lines in scope.</div>{% endif %}
  <div class="foot">Part 3 &middot; Sector Performance Report &middot; {{ params.year }} &middot; Amounts in AED</div>
</div>

{#- ═══ PART 4 — TOP 5 PROJECTS BUDGET BY DEPARTMENT ═══════════════════ -#}
{%- for d in DEP %}
{%- set dcc = d.get('cost_centre') or '-' %}
{%- set dprj = DPRJ|selectattr('cost_centre','equalto',dcc)|list %}
{%- set dknd = DKND|selectattr('cost_centre','equalto',dcc)|list %}
<div class="page">
